<!DOCTYPE html>
<html lang="en" >
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="./style.css">
    <style>
        body {
            background-color: #f0f0f0;
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 20px;
        }
        h1 {
            text-align: center;
            color: #333;
        }
        .chat {
            background-color: #fff;
            border-radius: 5px;
            padding: 15px;
            margin-bottom: 10px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        }
        .sender {
            font-weight: bold;
        }
        hr {
            border: 0;
            height: 1px;
            background-color: #ccc;
            margin: 20px 0;
        }
        p {
            margin: 5px 0;
        }
        @media (max-width: 600px) {
            body {
                padding: 10px;
            }
            .chat {
                padding: 10px;
            }
        }
    </style>
</head>
<body>
    <h1><u>U Chat</u></h1>
    <p></p>

    <% for (let chat of chats) { %>
        <div class="chat">
            <p class="sender">Sender : <%= chat.from %></p>
            <p class="msg" >Message : <%= chat.message %></p>
            <p class="receiver" dir="rtl">Receiver : <%= chat.to %></p>
        </div>
        <hr>
    <% } %>
</body>
</html>